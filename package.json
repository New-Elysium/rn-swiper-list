{
  "name": "@psync/rn-swiper",
  "version": "2.0.0",
  "description": "⚡ Lightning fast and customizable tinder-like swiper for React Native",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "bun --cwd example",
    "dev": "bun --cwd example start",
    "test": "jest",
    "test:e2e": "node e2e/swipe.e2e.mjs",
    "typecheck": "bun check",
    "lint": "eslint .",
    "clean": "del-cli lib",
    "prepare": "bob build",
    "release": "release-it --only-version"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "swiper",
    "tinder",
    "cards",
    "animation",
    "reanimated",
    "gesture-handler"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/New-Elysium/rn-swiper-list.git"
  },
  "author": "Omer Esmer <oesmer.oe@gmail.com> (https://github.com/Skipperlla)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/New-Elysium/rn-swiper-list/issues"
  },
  "homepage": "https://github.com/New-Elysium/rn-swiper-list#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/compat": "^2.1.1",
    "@evilmartians/lefthook": "^2.2.2",
    "@react-native/babel-preset": "^0.88.1",
    "@react-native/eslint-config": "^0.88.1",
    "@react-native/jest-preset": "^0.88.1",
    "@release-it/conventional-changelog": "^12.0.2",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "@typescript-eslint/parser": "^8.72.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "babel-jest": "^30.5.2",
    "commitlint": "^21.2.4",
    "del-cli": "^8.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^30.5.2",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-native": "^0.88.1",
    "react-native-builder-bob": "^0.44.1",
    "react-native-gesture-handler": "^3.4.0",
    "react-native-reanimated": "^4.7.1",
    "react-native-worklets": "^0.13.1",
    "release-it": "^21.1.2",
    "test-renderer": "^1.3.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": "*",
    "react-native-gesture-handler": ">=3.0.0",
    "react-native-reanimated": ">=4.0.0",
    "react-native-worklets": ">=0.13.0"
  },
  "workspaces": [
    "example"
  ],
  "jest": {
    "preset": "@react-native/jest-preset",
    "resolver": "react-native-reanimated/jest/resolver",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/example/",
      "<rootDir>/lib/"
    ],
    "setupFiles": [
      "react-native-gesture-handler/jestSetup.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|react-native-gesture-handler|react-native-reanimated|react-native-worklets)/)"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "increment": false,
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json",
          "tsc": "./node_modules/@typescript/native/bin/tsc"
        }
      ]
    ]
  },
  "create-react-native-library": {
    "languages": "js",
    "type": "library",
    "version": "0.54.6"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
